generator client {
  provider="prisma-client-js"
  output="../src/config/client"
}

datasource db {
  provider="postgresql"
  url=env("DATABASE_URL")
  directUrl=env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}