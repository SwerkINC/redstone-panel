{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "tsc -b",
        "start": "ts-node -r @swc-node/register -r tsconfig-paths/register index.ts",
        "dev": "nodemon --exec \"node -r @swc-node/register -r tsconfig-paths/register\" index.ts",
        "lint": "eslint . --config eslint.config.ts",
        "format": "prettier --write \"./**/*.{ts,js,json}\" --config .prettierrc",
        "test": "dotenv -e .env.test -- pnpm run test:db:push && dotenv -e .env.test -- pnpm run test:seed && dotenv -e .env.test -- tsx --test test/**/*.test.ts",
        "test:db:push": "prisma db push",
        "test:seed": "ts-node -r @swc-node/register -r tsconfig-paths/register prisma/fixtures/test-seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.18.0",
    "dependencies": {
        "@fastify/multipart": "^9.3.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/schedule": "^6.0.0",
        "@fastify/sensible": "^6.0.3",
        "@fastify/under-pressure": "^9.0.3",
        "@getbrevo/brevo": "^3.0.1",
        "@prisma/adapter-pg": "^7.0.0",
        "@prisma/client": "^7.0.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^17.2.3",
        "fastify": "^5.6.2",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^7.0.10",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.2",
        "qrcode": "^1.5.4",
        "speakeasy": "^2.0.0",
        "toad-scheduler": "^3.1.0",
        "uuid": "^13.0.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@fastify/cors": "^11.1.0",
        "@fastify/helmet": "^13.0.2",
        "@prisma/adapter-pg": "^7.0.0",
        "@swc-node/register": "^1.11.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.10.1",
        "@types/nodemailer": "^7.0.4",
        "@types/qrcode": "^1.5.6",
        "@types/speakeasy": "^2.0.10",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.1",
