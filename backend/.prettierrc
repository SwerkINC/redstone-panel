{
  "semi": true,
  "tabWidth": 4,
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^fastify",
    "^prisma",
    "^@/config(.*)$",
    "^@/modules(.*)$",
    "^@/types(.*)$",
    "^@/services(.*)$",
    "^@/middlewares(.*)$",
    "^@/routes(.*)$",
    "^@/plugins(.*)$",
    "^@/utils(.*)$",
    "^@?\\w",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
